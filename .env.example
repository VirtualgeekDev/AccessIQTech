# AccessIQ Tech Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_NAME="AccessIQ Tech"
APP_URL="https://accessiqtech.net"
APP_ENV="production"
APP_DEBUG="false"

# Database Configuration (Hostinger MySQL)
DB_HOST="localhost"
DB_NAME="your_actual_database_name_from_cpanel"
DB_USER="your_actual_username_from_cpanel"
DB_PASS="your_actual_hostinger_password"
DB_CHARSET="utf8mb4"

# Encryption Key (Generate a secure 32-character key)
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# SMTP Configuration (Hostinger Email)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_USERNAME="contact@accessiqtech.net"
SMTP_PASSWORD="Mkan@54221960"
SMTP_ENCRYPTION="tls"

# Payment Gateway Keys (Set via Admin Panel)
# These are stored in the database settings table
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""

# Axe Developer Hub Configuration
AXE_API_KEY="60c86d95-6d67-463e-bf7b-f0f21da8ebcb"
AXE_SERVER_URL="https://axe.deque.com"

# Security
SESSION_LIFETIME="7200"
CSRF_TOKEN_LIFETIME="3600"

# File Upload
MAX_UPLOAD_SIZE="10M"
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"

# Rate Limiting
API_RATE_LIMIT="100"
API_RATE_WINDOW="3600"

# Caching
CACHE_DRIVER="file"
CACHE_LIFETIME="3600"

# Logging
LOG_LEVEL="error"
LOG_FILE="/var/log/accessiq_tech.log"