{
    "name": "accessiq/tech",
    "description": "AccessIQ Tech - AI-Powered Web Accessibility SaaS",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "App\\": "backend/src/"
        }
    },
    "require": {
        "php": ">=8.0",
        "stripe/stripe-php": "^14.0",
        "paypal/rest-api-sdk-php": "^1.14",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'Dependencies installed successfully!'"
        ]
    }
}